{
  "name": "invictus-tournament-maker",
  "description": "Create and simulate football tournaments in seconds",
  "private": true,
  "version": "3.6.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "release-it",
    "release:patch": "release-it patch",
    "release:minor": "release-it minor",
    "release:major": "release-it major",
    "release:dry": "release-it --dry-run",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.2.1",
    "@capacitor-community/in-app-review": "^8.0.0",
    "@capacitor-firebase/analytics": "^8.5.2",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/share": "^8.0.3",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@lucide/vue": "^1.60.0",
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-ethers": "^1.8.24",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.1",
    "circle-flags": "^2.8.3",
    "ethers": "^6.17.0",
    "facesjs": "^5.0.3",
    "firebase": "^12.19.0",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate-2": "^2.0.32",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.11.0",
    "sharp": "^0.35.5",
    "vue": "^3.5.44",
    "vue-draggable-plus": "^0.6.1",
    "vue-i18n": "^11.4.16",
    "vue-router": "^5.4.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "release-it": "^21.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,scss,json,md}": [
      "prettier --write"
    ]
  }
